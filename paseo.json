{
  "worktree": {
    "setup": ["npm ci", "node ./scripts/seed-worktree-dev-state.mjs", "npm run build:daemon"]
  },
  "scripts": {
    "daemon": {
      "type": "service",
      "command": "PASEO_DEV_MANAGED_HOME=1 PASEO_DEV_ROOT=\"${PASEO_WORKTREE_PATH:-$PWD}\" PASEO_HOME=\"${PASEO_WORKTREE_PATH:-$PWD}/.dev/paseo-home\" PASEO_LISTEN=0.0.0.0:${PASEO_PORT:-6768} npm run dev"
    },
    "desktop": {
      "command": "npm run dev:desktop"
    },
    "ios": {
      "command": "npm run dev:ios"
    },
    "android": {
      "command": "npm run dev:android"
    },
    "typecheck": {
      "command": "npm run typecheck"
    }
  }
}
