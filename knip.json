{
  "$schema": "./node_modules/knip/schema.json",
  "workspaces": {
    "plugins": {
      "entry": ["**/index.{server,client}.{ts,tsx}", "**/*.test.ts"],
      "project": ["**/*.{ts,tsx}"]
    },
    ".": {
      "entry": ["scripts/**/*.{js,mjs,cjs,ts}"],
      "project": ["scripts/**/*.{js,mjs,cjs,ts}"]
    },
    "packages/daemon/plugin-worker": {
      "entry": ["index.ts", "src/**/*.test.ts"],
      "project": ["index.ts", "src/**/*.ts"]
    },
    "packages/relay": {
      "entry": ["src/index.ts", "src/e2ee.ts", "src/cloudflare-adapter.ts", "src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/website": {
      "entry": ["src/router.tsx", "vite.config.ts", "src/routes/**/*.tsx"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignore": ["src/routeTree.gen.ts"]
    },
    "packages/highlight": {
      "entry": ["src/index.ts", "src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    }
  },
  "ignoreDependencies": [
    "@playwright/test",
    "concurrently",
    "get-port-cli",
    "patch-package",
    "cross-env"
  ],
  "ignoreBinaries": ["playwright", "wrangler", "vitest", "open"]
}
